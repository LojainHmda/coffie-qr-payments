# ---------------------------------------------------------------------------
# AFS payment gateway (TEST environment only)
#
# Copy this file to .env.local and fill in the values AFS provided.
# NEVER commit real credentials. NEVER prefix any of these with NEXT_PUBLIC_ —
# that would ship the access token to the browser.
# ---------------------------------------------------------------------------

# Merchant entity id supplied by AFS.
AFS_ENTITY_ID=

# Bearer access token supplied by AFS. Server-side only.
AFS_ACCESS_TOKEN=

# AFS TEST endpoint. Must end with a trailing slash.
AFS_BASE_URL=https://eu-test.oppwa.com/

# ISO 4217 currency for the POC.
AFS_CURRENCY=AED

# Provided by AFS after they configure our webhook URL. 64 hex characters.
# Leave empty until then: the webhook acknowledges but does not verify.
AFS_WEBHOOK_DECRYPTION_KEY=

# Absolute public base URL of this app, used to build the shopperResultUrl AFS
# redirects back to. Leave empty locally (the request origin is used); set it
# to the https URL when deployed or when tunnelling through ngrok/cloudflared.
APP_BASE_URL=

# ---------------------------------------------------------------------------
# Wallets: Apple Pay and Google Pay
#
# The integration is fully implemented (lib/payments/wallets.ts,
# components/pay/wpwlOptions.ts). What follows is the configuration it needs.
# ---------------------------------------------------------------------------

# Wallet payment methods AFS has actually provisioned on the entity above.
# Comma-separated: APPLE_PAY, GOOGLE_PAY. Card is always available and is not
# listed here.
#
# Set this only once AFS has confirmed the wallet is live on your entity. The
# entity was last probed against the TEST gateway and resolved to brands
# ["MASTER","VISA"] with no applePayConfig/googlePayConfig — with that still
# true, switching a wallet on here puts a button on screen that AFS will refuse
# when it is tapped.
#
# Both wallets additionally require HTTPS on a public domain (Apple Pay also
# requires a domain-association file), so neither can be demoed over a LAN
# address. The Cloud Run URL works; http://192.168.x.x:3000 never will.
AFS_WALLET_METHODS=

# Merchant name shown on the Apple Pay sheet and the Google Pay sheet, and used
# as the Apple Pay total's label. Use the name customers see on their statement.
AFS_WALLET_DISPLAY_NAME=Coffee Machine

# Two-letter ISO 3166 country of the merchant, for the Apple Pay sheet.
AFS_WALLET_COUNTRY=AE

# Card networks to accept in both wallets, comma-separated. Translated to each
# vendor's spelling automatically. Keep this in step with the brands AFS has
# actually enabled. Supported: VISA, MASTERCARD, AMEX, DISCOVER, JCB
# (Apple only, additionally: MAESTRO, MADA, ELECTRON).
AFS_WALLET_NETWORKS=VISA,MASTERCARD

# Apple Merchant ID. Leave empty when using AFS's own Apple Pay certificates —
# the entity id is then used, which is what AFS registers with Apple. Setting
# it enables the applePayCapabilities availability check, which also reports
# whether the customer actually has a usable card.
AFS_APPLE_PAY_MERCHANT_ID=

# Google Pay Business Console merchant id. Optional in TEST; REQUIRED once your
# site is approved by Google and you point AFS_BASE_URL at production.
AFS_GOOGLE_PAY_MERCHANT_ID=

# Who decrypts the wallet token: PLATFORM (AFS does it — brands APPLEPAY /
# GOOGLEPAY) or ACQUIRER (the acquirer does it — brands APPLEPAYTKN /
# GOOGLEPAYTKN). Leave empty for PLATFORM, which needs no acquirer setup.
AFS_WALLET_DECRYPTION=

# Only for AFS_WALLET_DECRYPTION=ACQUIRER: the payment provider configured for
# Google Pay, sent as googlePay.gateway.
AFS_GOOGLE_PAY_GATEWAY=

# Ask the wallet sheet for the customer's email and billing address and submit
# them with the payment. Off by default: the checkout already sends the
# customer/billing fields 3-D Secure 2 needs, and every extra field on the
# sheet is friction at a vending machine. Set to true if your acquirer requires
# the real cardholder address.
AFS_WALLET_COLLECT_CONTACT=

# Base URL the machine QR codes should encode. Leave empty: the QR page uses
# the address you opened it with, so opening it at http://<lan-ip>:3000 makes
# every QR point at that same LAN address. Set it only to force something else,
# such as an https tunnel URL.
QR_BASE_URL=

# ---------------------------------------------------------------------------
# Machines
# ---------------------------------------------------------------------------

# API keys the coffee machines authenticate with, as CODE:key pairs.
#
#   MACHINE_API_KEYS=MACHINE-001:xxxx,MACHINE-002:yyyy,MACHINE-003:zzzz
#
# A machine's identity comes from its key and from nothing else — the request
# body cannot name a machine — so this key is what stops one machine writing
# orders against another.
#
# LEAVE THIS EMPTY AND EVERY MACHINE USES THE DEMO KEY COMMITTED TO THIS REPO
# (lib/catalog/machines.ts). Fine on a laptop, never anywhere else. The
# /admin/machines page says out loud which machines are still on a demo key.
MACHINE_API_KEYS=

# ---------------------------------------------------------------------------
# Jetinno IOT Payment Universal Interface (spec A5)
#
# For real Jetinno vending hardware. Their machine is the CLIENT: it prices its
# own basket and calls us for a QR string. We implement four endpoints and call
# one of theirs back. Leave these empty and the endpoints exist but refuse
# every request — they never accept unsigned traffic.
#
# Give Jetinno these URLs for the merchant:
#   Get QR Code   https://<your-host>/api/v1/jetinno/getQrCode
#   Scanned pay   https://<your-host>/api/v1/jetinno/payBarCode
#   Refund        https://<your-host>/api/v1/jetinno/refund
#   Order done    https://<your-host>/api/v1/jetinno/productdone
# ---------------------------------------------------------------------------

# Merchant identifier issued by Guangzhou Jetinno. Appears in every message.
JETINNO_USERNAME=

# Shared secret behind every MD5 signature, in both directions. Spec says 16
# bytes. SERVER-ONLY — never prefix with NEXT_PUBLIC_.
JETINNO_APIKEY=

# Merchant number, if Jetinno issued one. When set, a request carrying a
# different merchantNo is refused.
JETINNO_MERCHANT_NO=

# Upper bound on a single order, in cents. Default 100000.
#
# This protocol has the MACHINE state the price — there is no field in which
# the server could answer with a different one. The signature proves a message
# is authentic; it does not prove the number inside it is sane. A firmware
# decimal-point bug signs just as validly as a correct price, so this is the
# backstop that catches it.
JETINNO_MAX_ORDER_MINOR=

# Map Jetinno device numbers onto the machines in lib/catalog/machines.ts, as
# deviceNo:CODE pairs:
#
#   JETINNO_DEVICE_MAP=44401:MACHINE-001,44402:MACHINE-002
#
# Optional. An unmapped device still sells — its orders are attributed to
# "jetinno:<deviceNo>" and the dashboard shows that id.
JETINNO_DEVICE_MAP=

# NOTE: APP_BASE_URL above is REQUIRED for Jetinno. The qrCode field we return
# holds 128 characters and carries the pay URL, and a machine on a shop floor
# cannot reach a LAN address or localhost.

# How long a QR printed by a machine can still start a payment, in minutes.
# After this the code is dead and the customer is told to order again; nothing
# was charged. A payment already under way is still settled after it lapses —
# a 3-D Secure challenge can easily outlast the window.
ORDER_PAY_WINDOW_MINUTES=15
