# ---------------------------------------------------------------------------
# AFS payment gateway (TEST environment only)
#
# Copy this file to .env.local and fill in the values AFS provided.
# NEVER commit real credentials. NEVER prefix any of these with NEXT_PUBLIC_ —
# that would ship the access token to the browser.
# ---------------------------------------------------------------------------

# Merchant entity id supplied by AFS.
AFS_ENTITY_ID=

# Bearer access token supplied by AFS. Server-side only.
AFS_ACCESS_TOKEN=

# AFS TEST endpoint. Must end with a trailing slash.
AFS_BASE_URL=https://eu-test.oppwa.com/

# ISO 4217 currency for the POC.
AFS_CURRENCY=AED

# Provided by AFS after they configure our webhook URL. 64 hex characters.
# Leave empty until then: the webhook acknowledges but does not verify.
AFS_WEBHOOK_DECRYPTION_KEY=

# Absolute public base URL of this app, used to build the shopperResultUrl AFS
# redirects back to. Leave empty locally (the request origin is used); set it
# to the https URL when deployed or when tunnelling through ngrok/cloudflared.
APP_BASE_URL=

# Wallet payment methods AFS has actually provisioned on the entity above.
# Comma-separated: APPLE_PAY, GOOGLE_PAY. Card is always available and is not
# listed here.
#
# LEAVE THIS EMPTY unless AFS has confirmed the wallet is live on your entity.
# The configured entity was probed against the TEST gateway and resolves to
# brands ["MASTER","VISA"] with no applePayConfig/googlePayConfig, so neither
# wallet works today. Setting this without AFS enabling it would put a button
# on screen that cannot complete a payment.
#
# Both wallets additionally require HTTPS on a public domain (Apple Pay also
# requires a domain-association file), so neither can be demoed over a LAN
# address.
AFS_WALLET_METHODS=

# Base URL the machine QR codes should encode. Leave empty: the QR page uses
# the address you opened it with, so opening it at http://<lan-ip>:3000 makes
# every QR point at that same LAN address. Set it only to force something else,
# such as an https tunnel URL.
QR_BASE_URL=
